<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="CommunityConcernSystem"/>
        <attribute name="authors" value="System Architect"/>
        <attribute name="about" value="Community Concern Reporting and Response System"/>
        <attribute name="saved" value="2026-05-07 02:06:22 AM"/>
        <attribute name="created" value="2024-01-15 09:00:00 AM"/>
        <attribute name="edited" value="bmFvbWk7TVNJOzIwMjYtMDUtMDc7MDI6MDY6MjIgQU07MzsyMTM4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="GROUP - 8&#13;&#10;BSCpE - 1-6"/>
            <declare name="userType" type="String" array="False" size=""/>
            <declare name="concern" type="String" array="False" size=""/>
            <declare name="severity" type="Boolean" array="False" size=""/>
            <declare name="Minor" type="String" array="False" size=""/>
            <declare name="Major" type="String" array="False" size=""/>
            <declare name="Critical" type="String" array="False" size=""/>
            <declare name="referenceNumber" type="String" array="False" size=""/>
            <declare name="status" type="String" array="False" size=""/>
            <declare name="adminName" type="String" array="False" size=""/>
            <declare name="adminPassword" type="String" array="False" size=""/>
            <declare name="securityNumber" type="String" array="False" size=""/>
            <declare name="tier" type="String" array="False" size=""/>
            <declare name="validLogin" type="Boolean" array="False" size=""/>
            <output expression="&quot;Select User Type: Resident or Admin&quot;" newline="True"/>
            <input variable="userType"/>
            <if expression="userType == &quot;Resident&quot;">
                <then>
                    <output expression="&quot;What's your Concern?&quot;" newline="True"/>
                    <input variable="concern"/>
                    <output expression="&quot;What is the severity of the concern? (Minor, Major, Critical)&quot;" newline="True"/>
                    <input variable="severity"/>
                    <assign variable="severity" expression="True"/>
                    <if expression="severity == &quot;Minor&quot;">
                        <then>
                            <output expression="&quot;Barangay Hotline : (02) 0000 - 0000&quot;" newline="True"/>
                            <output expression="&quot;City Hall: 234-5678&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="severity == &quot;Major&quot;">
                                <then>
                                    <output expression="&quot;Police Non-Emergency: 345-6789&quot;" newline="True"/>
                                    <output expression="&quot;Fire Department (Sta. Mesa):(02) 8716-1634 or 0917-834-0309&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="severity == &quot;Critical&quot;">
                                        <then>
                                            <output expression="&quot;Contact this Immediately&quot;" newline="True"/>
                                            <output expression="&quot;National Emergency Hotline: 911&quot;" newline="True"/>
                                            <output expression="&quot;NDRRMC: (02) 8911-5061 to 65 (local 100), (02) 8911-1406, (02) 8912-2665, (02) 8912-5668, and (02) 8911-1873&quot;" newline="True"/>
                                            <output expression="&quot;Manila City Hall (Disaster Risk Reduction): (02) 8527-5174&quot;" newline="True"/>
                                            <output expression="&quot;Manila Fire District HQ: (02) 8527-3604 / (02) 8527-3606&quot;" newline="True"/>
                                        </then>
                                        <else/>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                    <output expression="&quot;Concern submitted to Government Officials&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="userType == &quot;Admin&quot;">
                        <then>
                            <output expression="&quot;Admin Login Portal&quot;" newline="True"/>
                            <output expression="&quot;Enter Name:&quot;" newline="True"/>
                            <input variable="adminName"/>
                            <output expression="&quot;Enter Password:&quot;" newline="True"/>
                            <input variable="adminPassword"/>
                            <output expression="&quot;Enter Security Number:&quot;" newline="True"/>
                            <input variable="securityNumber"/>
                            <assign variable="validLogin" expression="False"/>
                            <if expression="securityNumber == &quot;11111A&quot;">
                                <then>
                                    <assign variable="tier" expression="&quot;Minor&quot;"/>
                                    <assign variable="validLogin" expression="True"/>
                                </then>
                                <else>
                                    <if expression="securityNumber == &quot;12121B&quot;">
                                        <then>
                                            <assign variable="tier" expression="&quot;Major&quot;"/>
                                            <assign variable="validLogin" expression="True"/>
                                        </then>
                                        <else>
                                            <if expression="securityNumber == &quot;13131C&quot;">
                                                <then>
                                                    <assign variable="tier" expression="&quot;Critical&quot;"/>
                                                    <assign variable="validLogin" expression="True"/>
                                                </then>
                                                <else/>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                            <if expression="validLogin == True">
                                <then>
                                    <output expression="&quot;Login Successful! Access Granted&quot;" newline="True"/>
                                    <output expression="&quot;Viewing &quot; &amp; tier &amp; &quot; Concerns arranged by time reported&quot;" newline="True"/>
                                    <output expression="&quot;Admin can update status: Resolved, Unresolved, Ongoing, or Reported&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Login Failed! Invalid Credentials&quot;" newline="True"/>
                                </else>
                            </if>
                        </then>
                        <else>
                            <output expression="&quot;Invalid User Type&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
